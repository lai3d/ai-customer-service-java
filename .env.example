# Copy to .env and fill in. .env is git-ignored.
# Get a key at https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Postgres (defaults match docker-compose.yml; override only if you changed it)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=csagent
POSTGRES_USER=csagent
POSTGRES_PASSWORD=csagent

# Tracing. docker compose sets these for you; they matter only when running the app directly.
OTLP_TRACING_EXPORT_ENABLED=false
OTLP_TRACING_ENDPOINT=http://localhost:4318/v1/traces   # Compose sets this to Tempo; the collector profile overrides it
OTLP_METRICS_EXPORT_ENABLED=false                        # push metrics over OTLP too (the collector profile); pull is the default
OTLP_METRICS_ENDPOINT=http://localhost:4318/v1/metrics
TRACING_SAMPLE_RATE=1.0
# GRAFANA_PORT=3000                 # Compose only: host ports for the Grafana stack
# PROMETHEUS_PORT=9090
# OTLP_HTTP_PORT=4318
# Attaches the customer's question to vector-store spans. Debugging only.
TRACE_INCLUDE_QUERY_CONTENT=false

# --- Alternative chat providers -------------------------------------------------
# Switching provider is configuration only; no code changes.
#   Anthropic (default): CHAT_PROVIDER=anthropic
#   OpenAI:              CHAT_PROVIDER=openai      + OPENAI_API_KEY
#   Gemini:              CHAT_PROVIDER=google-genai + GEMINI_API_KEY
#   Grok (xAI):          CHAT_PROVIDER=openai      + OPENAI_API_KEY=<xAI key>
#                        OPENAI_BASE_URL=https://api.x.ai + OPENAI_CHAT_MODEL=<grok model>
CHAT_PROVIDER=anthropic
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com
# OPENAI_CHAT_MODEL=gpt-5
# GEMINI_API_KEY=
# GEMINI_CHAT_MODEL=gemini-3-pro-preview

# --- Cost and resilience ---------------------------------------------------------
CONVERSATION_TOKEN_BUDGET=200000   # 0 disables the per-conversation cap; spend is shared in Postgres
AI_RETRY_MAX_ATTEMPTS=3
HTTP_CONNECT_TIMEOUT=10s
HTTP_READ_TIMEOUT=120s
TURN_LEASE=150s                    # one turn per conversation at a time; must exceed HTTP_READ_TIMEOUT
APP_RAG_IMPORT_MODE=startup        # startup | once (import then exit) | off

# --- Running the roles as separate processes (APP_TARGET=chat|knowledge|ticket) ------------
# Unused by APP_TARGET=all, which is what this file's Compose stack runs. A chat process needs
# all three; a knowledge or ticket process needs the token. See docs/adr/001-deployment-targets.md.
APP_TARGET=all
INTERNAL_TOKEN=                    # shared secret on every /internal/** call, service to service
KNOWLEDGE_URL=                     # e.g. http://knowledge:8080
TICKET_URL=                        # e.g. http://ticket:8080
SERVICES_TIMEOUT=5s                # connect and read timeout for internal calls

# Grok (xAI): CHAT_PROVIDER=xai. Its own provider with its own credentials -- no borrowing
# OPENAI_API_KEY, so both can be configured at once. It is built on the OpenAI client because
# xAI speaks that protocol; see docs/providers.md.
XAI_API_KEY=
# XAI_CHAT_MODEL=grok-4.6
